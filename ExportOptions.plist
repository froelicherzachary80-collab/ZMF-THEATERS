<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Example export options for an Ad Hoc ("release-testing") signed IPA.
     Replace YOUR_TEAM_ID and the profile name, or let the CI workflow fill them
     in from the TEAM_ID / PROVISIONING_PROFILE_BASE64 secrets.
     For your own device with a free or paid account you can also use
     method = "debugging" (development). -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>release-testing</string>
	<key>teamID</key>
	<string>YOUR_TEAM_ID</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.zmf.theatersplus</key>
		<string>YOUR_PROFILE_NAME</string>
	</dict>
	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
