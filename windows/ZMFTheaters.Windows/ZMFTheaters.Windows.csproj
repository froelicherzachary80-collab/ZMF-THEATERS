<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZMFTheaters</AssemblyName>
    <RootNamespace>ZMFTheaters</RootNamespace>
    <ApplicationIcon>Assets\zmf.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>ZMF THEATERS+ for Windows</Product>
    <Company>ZMF</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Only ship the 64-bit LibVLC runtime. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zmf.png" />
  </ItemGroup>

</Project>
