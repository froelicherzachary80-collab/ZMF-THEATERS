<Window x:Class="ZMFTheaters.TheaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="ZMF THEATERS+ · Theater" Background="Black" WindowStyle="None" WindowState="Maximized"
        Icon="Assets/zmf.png" Loaded="OnLoaded" Closing="OnClosing" KeyDown="OnKeyDown" MouseMove="OnMouseMove">
    <Window.Resources>
        <LinearGradientBrush x:Key="Curtain" StartPoint="0,0" EndPoint="0.18,0" SpreadMethod="Repeat">
            <GradientStop Color="#3A0308" Offset="0"/>
            <GradientStop Color="#8E0E1A" Offset="0.45"/>
            <GradientStop Color="#B3172A" Offset="0.55"/>
            <GradientStop Color="#3A0308" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Valance" StartPoint="0,0" EndPoint="0.03,0" SpreadMethod="Repeat">
            <GradientStop Color="#4A050C" Offset="0"/>
            <GradientStop Color="#A01425" Offset="0.5"/>
            <GradientStop Color="#4A050C" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ZButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.07*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>

        <!-- Auditorium walls -->
        <Rectangle Grid.RowSpan="3">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop x:Name="WallTint" Color="#2A0A10" Offset="0"/>
                    <GradientStop Color="#050203" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Valance with gold trim -->
        <Grid Grid.Row="0">
            <Rectangle Fill="{StaticResource Valance}"/>
            <Rectangle Height="5" VerticalAlignment="Bottom" Fill="#D9A640"/>
            <TextBlock x:Name="RoomTitle" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black"
                       FontSize="18" Foreground="#FFD27A" Text="ZMF THEATERS+"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.08*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.08*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{StaticResource Curtain}"/>
            <Rectangle Grid.Column="2" Fill="{StaticResource Curtain}"/>

            <!-- Light spilling around the screen -->
            <Border x:Name="Glow" Grid.Column="1" Margin="10" Background="#FFEFD8" Opacity="0.12" CornerRadius="10">
                <Border.Effect><BlurEffect Radius="70"/></Border.Effect>
            </Border>
            <Border Grid.Column="1" Margin="26,18" Background="Black" BorderBrush="#0A0A0A" BorderThickness="8">
                <vlc:VideoView x:Name="Video">
                    <Grid x:Name="Overlay" Background="#01000000" MouseMove="OnMouseMove" MouseLeftButtonDown="OnOverlayClick">
                        <StackPanel x:Name="SlidePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="SlideTop" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SlideBig" FontSize="64" FontWeight="Black" Foreground="#FFC84B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SlideBottom" FontSize="22" Foreground="#E8E0D8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border x:Name="PartyBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Padding="10,5"
                                CornerRadius="12" Background="#AA0E3B1C" Visibility="Collapsed">
                            <TextBlock x:Name="PartyText" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </vlc:VideoView>
            </Border>
        </Grid>

        <!-- Rows of seats in front of you -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <UniformGrid x:Name="SeatsBack" Rows="1" Margin="140,0,140,46" Height="44" VerticalAlignment="Bottom"/>
            <UniformGrid x:Name="SeatsFront" Rows="1" Margin="40,0,40,-10" Height="62" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- House lights: darkens the room (never the picture — the video is its own surface) -->
        <Rectangle x:Name="Dimmer" Grid.RowSpan="3" Fill="Black" Opacity="0.05" IsHitTestVisible="False"/>

        <!-- Controls (fade out while watching; move the mouse to bring them back) -->
        <Border x:Name="Controls" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                CornerRadius="14" Background="#E6120A0E" BorderBrush="#55FFC84B" BorderThickness="1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="⏸" Click="OnPlayPause" ToolTip="Play / pause (Space)"/>
                <Button Style="{StaticResource IconButton}" Content="⟲10" Click="OnBack" ToolTip="Back 10 s (←)"/>
                <Button Style="{StaticResource IconButton}" Content="30⟳" Click="OnForward" ToolTip="Forward 30 s (→)"/>
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas" Text="0:00 / 0:00"/>
                <Slider x:Name="SeekBar" Width="360" VerticalAlignment="Center" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                        PreviewMouseUp="OnSeekRelease"/>
                <TextBlock Text="🔊" VerticalAlignment="Center" Margin="10,0,2,0"/>
                <Slider x:Name="VolumeBar" Width="90" VerticalAlignment="Center" Minimum="0" Maximum="100" ValueChanged="OnVolume"/>
                <ComboBox x:Name="AudioBox" Width="130" Margin="8,0,2,0" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="OnAudioChanged" ToolTip="Audio track"/>
                <ComboBox x:Name="SubBox" Width="130" Margin="2,0" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="OnSubChanged" ToolTip="Subtitles"/>
                <Button Style="{StaticResource IconButton}" Content="⛶" Click="OnFullscreen" ToolTip="Fullscreen picture (F)"/>
                <Button Style="{StaticResource IconButton}" Content="✕" Click="OnClose" ToolTip="Leave the theater (Esc)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
