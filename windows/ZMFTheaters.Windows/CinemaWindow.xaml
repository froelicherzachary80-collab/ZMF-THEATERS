<Window x:Class="ZMFTheaters.CinemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZMF THEATERS+ · Cinema" Background="Black" Width="1280" Height="760" WindowState="Maximized"
        Icon="Assets/zmf.png" Loaded="OnLoaded" Closing="OnClosing"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp" MouseMove="OnMouseMove"
        MouseDown="OnMouseDown" MouseUp="OnMouseUp">
    <Grid x:Name="Root" Background="Transparent">
        <Viewport3D x:Name="View" ClipToBounds="True" IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Cam" FieldOfView="75" NearPlaneDistance="0.05" FarPlaneDistance="200"
                                   Position="0,1.65,2" LookDirection="0,0,1" UpDirection="0,1,0"/>
            </Viewport3D.Camera>
            <ModelVisual3D x:Name="SceneVisual"/>
        </Viewport3D>

        <!-- 4DX smoke burst -->
        <Rectangle x:Name="Smoke" Fill="#D8E4EC" Opacity="0" IsHitTestVisible="False"/>
        <!-- Fullscreen picture (playback continues) -->
        <Image x:Name="Fullscreen" Visibility="Collapsed" Stretch="Uniform" Margin="0" IsHitTestVisible="False"/>

        <!-- HUD -->
        <Grid x:Name="Hud" Margin="16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Background="#99000000" CornerRadius="12" Padding="10,5" Margin="0,0,0,6">
                    <TextBlock x:Name="ZoneText" FontWeight="Bold" Text="Lobby"/>
                </Border>
                <Border Background="#99000000" CornerRadius="12" Padding="10,5" Margin="0,0,0,6">
                    <TextBlock x:Name="WalletText" FontWeight="Bold" Foreground="#FFD54F"/>
                </Border>
                <Border x:Name="TicketChip" Background="#99000000" CornerRadius="12" Padding="10,5" Visibility="Collapsed">
                    <TextBlock x:Name="TicketText" FontWeight="Bold" Foreground="#FFB74D"/>
                </Border>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border x:Name="GuideChip" Background="#99000000" CornerRadius="14" Padding="12,5" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="GuideArrow" Text="▲" FontSize="16" Foreground="#FFA726" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform x:Name="GuideRotate"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="GuideText" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ToastChip" Background="#CC000000" CornerRadius="14" Padding="12,6" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ToastText" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="StatusLine" Foreground="#80DEEA" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#99000000" CornerRadius="12" Padding="10,6">
                <TextBlock x:Name="HelpText" FontSize="12" Foreground="#DDD"
                           Text="WASD / arrows: walk · hold mouse button + drag: look · E: interact / sit · Q: stand · F: fullscreen picture · Space: play/pause · Esc: leave"/>
            </Border>
            <Border x:Name="PromptChip" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90"
                    Background="#CC1A0A10" BorderBrush="#FFC84B" BorderThickness="1" CornerRadius="10" Padding="14,8" Visibility="Collapsed">
                <TextBlock x:Name="PromptText" FontSize="15" FontWeight="Bold"/>
            </Border>

            <!-- Playback controls (seated) -->
            <Border x:Name="Controls" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"
                    CornerRadius="14" Background="#E6120A0E" BorderBrush="#55FFC84B" BorderThickness="1" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton" Content="⏸" Click="OnPlayPause" Padding="10,5"/>
                    <Button Content="⟲10" Click="OnBack" Padding="10,5"/>
                    <Button Content="30⟳" Click="OnForward" Padding="10,5"/>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas" Text="0:00 / 0:00"/>
                    <Slider x:Name="SeekBar" Width="320" VerticalAlignment="Center" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseUp="OnSeekRelease"/>
                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="10,0,2,0"/>
                    <Slider x:Name="VolumeBar" Width="90" VerticalAlignment="Center" Minimum="0" Maximum="100" ValueChanged="OnVolume"/>
                    <ComboBox x:Name="AudioBox" Width="120" Margin="8,0,2,0" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="OnAudioChanged"/>
                    <ComboBox x:Name="SubBox" Width="120" Margin="2,0" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="OnSubChanged"/>
                    <Button Content="⛶" Click="OnFullscreen" Padding="10,5"/>
                    <Button Content="Stand up" Click="OnStand" Padding="10,5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- In-world box office -->
        <Grid x:Name="BoxOffice" Background="#E6000000" Visibility="Collapsed">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="40" MaxWidth="1100" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ZMF BOX OFFICE" FontSize="24" FontWeight="Black" Foreground="{StaticResource GoldBrush}"/>
                        <TextBox x:Name="FilmSearch" DockPanel.Dock="Top" TextChanged="OnFilmSearch" Margin="0,8"/>
                        <ListBox x:Name="FilmList" Background="#140A0E" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 SelectionChanged="OnFilmSelected" MinHeight="380" DisplayMemberPath="Label"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock x:Name="SelTitle" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Text="Choose a film"/>
                        <TextBlock x:Name="SelRoom" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock Text="Format" FontWeight="Bold" Margin="0,10,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Fmt2D" Content="2D  Z$150" Foreground="White" Margin="0,0,14,0" IsChecked="True" Checked="OnFormatChanged"/>
                            <RadioButton x:Name="Fmt3D" Content="3D red/cyan  Z$225" Foreground="White" Margin="0,0,14,0" Checked="OnFormatChanged"/>
                            <RadioButton x:Name="Fmt4DX3D" Content="Auto 4DX 3D  Z$400" Foreground="#80DEEA" Checked="OnFormatChanged"/>
                            <RadioButton x:Name="Fmt4DX" Content="Auto 4DX  Z$400" Foreground="#80DEEA" Checked="OnFormatChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="FormatNote" Foreground="{StaticResource DimTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6"/>
                        <TextBlock Text="SCREEN" HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}" Margin="0,8,0,4"/>
                        <UniformGrid x:Name="SeatGrid" Rows="8" Columns="8" Width="360" Height="250"/>
                        <TextBlock x:Name="PriceText" FontWeight="Bold" Margin="0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BuyButton" Content="🎟  Buy ticket" Style="{StaticResource GoldButton}" Click="OnBuy" IsEnabled="False"/>
                            <Button Content="Close" Click="OnCloseBoxOffice"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

